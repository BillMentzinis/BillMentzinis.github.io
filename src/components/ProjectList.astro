---
import HorizontalCard from "./HorizontalCard.astro";
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{
  projects.map((project, i) => (
    <>
      {i > 0 && <div class="divider my-0" />}
      <HorizontalCard {...project} />
    </>
  ))
}
